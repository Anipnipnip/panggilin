# Panggilin Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENV=development

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@localhost:5432/database_name?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/panggilin?sslmode=disable

# Redis Configuration (Optional for basic ingestion, required for replay queue)
REDIS_URL=redis://localhost:6379/0

# Ingestion Constraints
MAX_BODY_SIZE_BYTES=1048576 # 1 MB
